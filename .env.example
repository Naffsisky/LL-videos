# Aiven MySQL — format: mysql://user:pass@host:port/db?ssl-mode=REQUIRED
DATABASE_URL="mysql://avnadmin:PASSWORD@mysql-xxx.aivencloud.com:PORT/defaultdb?ssl-mode=REQUIRED"

# Redis (local dev atau Aiven Redis: rediss://user:pass@host:port)
REDIS_URL="redis://localhost:6379"

# Cloudflare R2
R2_BUCKET_NAME="video-learning"
R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_URL="https://your-bucket.r2.dev"

# App
PORT=5173
NODE_ENV=development
MAX_ACTIVE_COURSES=5
